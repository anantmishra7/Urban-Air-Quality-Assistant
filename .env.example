# ============================================================
# BreatheCity AI – Environment Variables
# ============================================================
# Copy this file to .env and adjust values as needed.
# No secret API keys are required – Open-Meteo is free & keyless.
# ============================================================

# ── Database ─────────────────────────────────────────────────
# SQLite (default, local dev):
DATABASE_URL=sqlite:///./breathecity.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://user:password@host:5432/breathecity

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────────────
# Comma-separated origins allowed by CORS middleware
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Open-Meteo (no key required) ────────────────────────────
# Override base URLs only if using a self-hosted instance
# OPEN_METEO_AQ_URL=https://air-quality-api.open-meteo.com/v1/air_quality
# OPEN_METEO_WEATHER_URL=https://api.open-meteo.com/v1/forecast
# OPEN_METEO_GEO_URL=https://geocoding-api.open-meteo.com/v1/search

# ── Cache ────────────────────────────────────────────────────
CACHE_TTL=300          # seconds (5 minutes)
CACHE_MAX_SIZE=1000

# ── Uploads ──────────────────────────────────────────────────
MAX_UPLOAD_SIZE=5242880   # bytes (5 MB)
UPLOAD_DIR=uploads

# ── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT=60/minute

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Frontend (Vite) ──────────────────────────────────────────
VITE_API_BASE_URL=/api
